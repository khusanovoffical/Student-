<Window x:Class="Student.CreativeRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolControl · Creative"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="#060A14" Foreground="#F4F6FF"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Markaziy nurli fon effekti -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#0F1F3D" Offset="0.0"/>
                <GradientStop Color="#060A14" Offset="1.0"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="28"
                Background="#0B1325" Padding="54,46"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="560">
            <StackPanel HorizontalAlignment="Center">

                <!-- Logo va Brending -->
                <Border Width="64" Height="64" CornerRadius="20" Background="#1E3A8A"
                        BorderBrush="#3B82F6" BorderThickness="2"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="SC" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SCHOOLCONTROL"
                           Foreground="#38BDF8" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" LetterSpacing="2"/>

                <TextBlock Text="CREATIVE"
                           FontSize="32" FontWeight="Black" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,4,0,10" LetterSpacing="1"/>

                <TextBlock Text="Sinfxonangizga xush kelibsiz."
                           Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <TextBlock Text="Darsni boshlash uchun ism va familiyangizni kiriting."
                           Foreground="#64748B" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Ism maydoni -->
                <TextBlock Text="ISMINGIZ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="4,0,0,6"/>
                <TextBox x:Name="FirstNameBox" Height="50" Padding="16,12" FontSize="16"
                         Background="#030712" Foreground="White" BorderBrush="#1E293B"
                         KeyDown="Input_KeyDown"/>

                <!-- Familiya maydoni -->
                <TextBlock Text="FAMILIYANGIZ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="4,16,0,6"/>
                <TextBox x:Name="LastNameBox" Height="50" Padding="16,12" FontSize="16"
                         Background="#030712" Foreground="White" BorderBrush="#1E293B"
                         KeyDown="Input_KeyDown"/>

                <!-- KATTA ENTER TUGMASI -->
                <Button x:Name="EnterButton" Content="ENTER  ↵" Height="54" Margin="0,26,0,0"
                        Background="#2563EB" Foreground="White" FontSize="16" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="EnterButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Holat matni -->
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#F59E0B" Margin="0,14,0,0" FontSize="12"/>

                <!-- Favqulodda IT Admin qismi -->
                <Expander Header="Texnik mutaxassis (Favqulodda ochish)"
                          Foreground="#475569" FontSize="11" Margin="0,18,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <PasswordBox x:Name="AdminPasswordBox" Width="130" Height="32" Padding="6"
                                     Background="#020617" Foreground="White" BorderBrush="#334155"/>
                        <Button Content="Ochish" Click="EmergencyUnlock_Click" Margin="8,0,0,0"
                                Padding="12,0" Background="#334155" Foreground="White" BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Border>
    </Grid>
</Window>
