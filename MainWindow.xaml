<Window x:Class="Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student · SchoolControl" Height="720" Width="1120" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" Foreground="#F4F6FF">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#10182A">
            <Grid Margin="54">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#263B70">
                        <TextBlock Text="SC" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SchoolControl" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="STUDENT CLIENT" Foreground="#8FA7FF" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="BILIM OLAMIGA" Foreground="#8FA7FF" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Xush kelibsiz!" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,15,0,0"/>
                    <TextBlock Text="Ushbu kompyuterdan hozir foydalanayotgan o‘quvchining ism-familiyasini kiriting." Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="25" Margin="0,13,0,0"/>
                    <Border Background="#192640" CornerRadius="16" Padding="17" Margin="0,30,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="#42D6C5" FontSize="23" Margin="0,0,13,0"/>
                            <StackPanel>
                                <TextBlock Text="Kompyuter doimiy, foydalanuvchi almashadi." FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Har yangi darsda o‘z ismingizni kiriting." Foreground="#9AA8C7" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="SchoolControl · Maktab kompyuter tizimi" Foreground="#65749A" FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="48">
            <Border Width="390" Padding="32" CornerRadius="22" Background="{StaticResource PanelBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#263653" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="O‘QUVCHI KIRISHI" Foreground="#8FA7FF" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Ismingizni kiriting" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <TextBlock Text="Bu kompyuterda hozir ishlayotgan o‘quvchi ma’lumotlari." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,27"/>
                    <TextBlock Text="Ism" Foreground="#DCE4FF" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="FirstNameBox" Height="48" Padding="13" FontSize="15" Background="#0D1426" Foreground="White" BorderBrush="#344463"/>
                    <TextBlock Text="Familiya" Foreground="#DCE4FF" FontSize="13" Margin="0,18,0,8"/>
                    <TextBox x:Name="LastNameBox" Height="48" Padding="13" FontSize="15" Background="#0D1426" Foreground="White" BorderBrush="#344463"/>
                    <Button x:Name="SubmitButton" Content="Tizimga kirish" Height="50" Margin="0,25,0,0"
                            Background="#526FE8" Foreground="White" FontSize="15" FontWeight="SemiBold"
                            BorderThickness="0" Click="SubmitButton_Click"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FFD98A" Margin="0,15,0,0" FontSize="12"/>
                    <TextBlock Text="Ism-familiya maktab kompyuteri va joriy foydalanuvchini moslashtirish uchun yuboriladi."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#7888AA" FontSize="10" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>