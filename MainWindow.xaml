<Window x:Class="Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolControl · O‘quvchi mijoz dasturi"
        Height="700" Width="1050" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="#F4F6FF">
    <Grid>
        <!-- AGAR TIZIMGA KIRILMAGAN BO'LSA: KIRISH EKRANI -->
        <Grid x:Name="LoginGrid" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Chap taraf: Banner va ma'lumot -->
            <Border Grid.Column="0" Background="#0C1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#1E3A8A">
                            <TextBlock Text="SC" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SchoolControl" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="TALABA ILOMETRI" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="MAKTAB EKOTIZIMI" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock Text="Darsga xush kelibsiz!" FontSize="32" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="Kompyuter maktab tarmog‘iga ulangan. O‘z ismingiz va familiyangizni kiritib darsga qo‘shiling."
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,14,0,0"/>

                        <!-- Tarmoq holati kartasi -->
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,28,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DiscoveryIndicator" Width="10" Height="10" Fill="{StaticResource CyanBrush}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DiscoveryStatusText" Text="Tarmoq tekshirilmoqda..." FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Kompyuter o‘zgarmas Device ID bilan himoyalangan." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="20,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="SchoolControl · Professional School Ecosystem" Foreground="#475569" FontSize="11"/>
                </Grid>
            </Border>

            <!-- O'ng taraf: Kirish formasi -->
            <Grid Grid.Column="1" Margin="40">
                <Border Width="380" Padding="32" CornerRadius="20" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="O‘QUVCHI TIZIMGA KIRISHI" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock Text="Ma’lumotlarni kiriting" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="Har dars boshida yangi o‘quvchi ro‘yxatga olinadi." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,22"/>

                        <TextBlock Text="Ism" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="FirstNameBox" Height="44" Padding="12,10" FontSize="14"
                                 Background="#020617" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>

                        <TextBlock Text="Familiya" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <TextBox x:Name="LastNameBox" Height="44" Padding="12,10" FontSize="14"
                                 Background="#020617" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>

                        <!-- Server manzili sozlamasi (ixtiyoriy o'zgartirish) -->
                        <Expander Header="Server manzili sozlamasi" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox x:Name="ServerUrlBox" Height="38" Padding="10,8" FontSize="12"
                                         Background="#020617" Foreground="#93C5FD" BorderBrush="{StaticResource BorderBrush}"
                                         Text="http://localhost:5123"/>
                                <TextBlock Text="Avtomatik topilmasa, o‘qituvchi IP manzilini kiriting." Foreground="#64748B" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="SubmitButton" Content="Tizimga kirish" Height="48" Margin="0,24,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="SubmitButton_Click"/>

                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="#FBBF24" Margin="0,14,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- AGAR TIZIMGA KIRILGAN BO'LSA: STUDENT DASHBOARD -->
        <Grid x:Name="DashboardGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ekran uzatish ogohlantirish banneri (faqat o'qituvchi ko'rayotganda chiqadi) -->
            <Border x:Name="ScreenSharingBanner" Grid.Row="0" Background="#065F46" BorderBrush="#10B981" BorderThickness="0,0,0,1"
                    Padding="16,10" Visibility="Collapsed">
                <DockPanel HorizontalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#34D399" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DIQQAT: O‘qituvchi ekranni ko‘rmoqda (Ko‘rinadigan faol dars sessiyasi)"
                               Foreground="#ECFDF5" FontSize="13" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>

            <!-- Top Header -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1E3A8A">
                            <TextBlock Text="SC" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DashboardStudentName" Text="O‘quvchi Ismi" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="DashboardDeviceName" Text="PC-01 · Device ID: ..." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- O'ng tarafda holat -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ConnectionStatusText" Text="Serverga ulangan" FontSize="12" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Chiqish" Margin="12,0,0,0" Padding="12,6"
                                Background="Transparent" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1"
                                Cursor="Hand" Click="Logout_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dashboard Kontent -->
            <Grid Grid.Row="2" Margin="30,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Chap taraf: Holat kartalari va Qoidalar -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="KOMPYUTER HOLATI" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,14"/>

                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DARS HOLATI" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LessonStateText" Text="Faol ish rejimi" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
                                <TextBlock Text="Kompyuter erkin foydalanishda" Foreground="#34D399" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="XAVFSIZLIK VA NAZORAT" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Faol" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
                                <TextBlock Text="Taqiqlangan o‘yinlar to‘silgan" Foreground="{StaticResource CyanBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Ogohlantirish bloki -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Maktab axborot xavfsizligi qoidalari" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="• Kompyuter faqat o‘quv maqsadlarida foydalaniladi." Foreground="#CBD5E1" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="• Ekran uzatish o‘qituvchi tomonidan faollashtirilganda yuqorida yashil xabar paydo bo‘ladi." Foreground="#CBD5E1" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="• O‘qituvchi yuborgan topshiriqlar va fayllar o‘ng paneldan yuklab olinadi." Foreground="#CBD5E1" FontSize="12" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- O'ng taraf: Fayllar almashinuvi -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="FAYLLAR VA TOPSHIRIQLAR" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Topshiriq yuborish" Padding="10,6"
                                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="UploadFile_Click"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" Text="O‘qituvchi yuborgan fayllar:" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>

                        <!-- Fayllar ro'yxati -->
                        <ListBox Grid.Row="2" x:Name="ReceivedFilesList" Background="#020617" BorderBrush="{StaticResource BorderBrush}"
                                 Foreground="#F1F5F9" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Ochish" Padding="10,4"
                                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                                    FontSize="11" Cursor="Hand" Click="OpenFile_Click" Tag="{Binding FilePath}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Info}" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
