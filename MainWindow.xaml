<Window x:Class="Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student · xumo.dev" Height="620" Width="920" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" Foreground="#F4F6FF">
    <Grid>
        <Border Width="460" Padding="34" CornerRadius="22" Background="{StaticResource PanelBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SCHOOL CONTROL" Foreground="#8FA7FF" FontSize="12" FontWeight="Bold" CharacterSpacing="180" HorizontalAlignment="Center"/>
                <TextBlock Text="Xush kelibsiz!" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock Text="Davom etish uchun ism va familiyangizni kiriting." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,28"/>
                <TextBlock Text="Ism" Foreground="#DCE4FF" Margin="0,0,0,7"/>
                <TextBox x:Name="FirstNameBox" Height="46" Padding="12" FontSize="15" Background="#0D1426" Foreground="White" BorderBrush="#2B3857"/>
                <TextBlock Text="Familiya" Foreground="#DCE4FF" Margin="0,18,0,7"/>
                <TextBox x:Name="LastNameBox" Height="46" Padding="12" FontSize="15" Background="#0D1426" Foreground="White" BorderBrush="#2B3857"/>
                <Button Content="Kirish" Click="Enter_Click" Height="48" Margin="0,26,0,0" Background="#6C8CFF" Foreground="White" FontSize="15" FontWeight="SemiBold" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FFD98A" Margin="0,16,0,0"/>
                <TextBlock Text="xumo.dev" Foreground="#65749A" FontSize="11" HorizontalAlignment="Center" Margin="0,28,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>