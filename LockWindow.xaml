<Window x:Class="Student.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolControl · Kompyuter qulflangan"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="#080D1A" Foreground="#F4F6FF"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#141E38" Offset="0.0"/>
                <GradientStop Color="#080D1A" Offset="1.0"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="24"
                Background="#0F172A" Padding="48,40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="620">
            <StackPanel HorizontalAlignment="Center">
                <!-- Qulf ikonasi -->
                <Border Width="88" Height="88" CornerRadius="28" Background="#1E293B"
                        BorderBrush="#3B82F6" BorderThickness="2"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Path Data="M 28,38 V 26 C 28,18 36,12 44,12 C 52,12 60,18 60,26 V 38 M 20,38 H 68 C 72,38 75,41 75,45 V 72 C 75,76 72,79 68,79 H 20 C 16,79 13,76 13,72 V 45 C 13,41 16,38 20,38 Z M 44,53 V 63"
                          Stroke="#38BDF8" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"/>
                </Border>

                <TextBlock Text="DIQQAT! DARS DAVOM ETMOQDA"
                           Foreground="#38BDF8" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" LetterSpacing="1"/>

                <TextBlock Text="Kompyuter vaqtincha qulflangan"
                           FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Border Background="#1E293B" CornerRadius="12" Padding="20,14" Margin="0,0,0,24">
                    <TextBlock x:Name="LockMessageText"
                               Text="O‘qituvchi kompyuterni dars jarayoni uchun qulfladi. Diqqatingizni doskaga qarating."
                               Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="22"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="O‘qituvchi buyrug‘i orqali ochiladi" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>

                <!-- Favqulodda admin ochish (Agar aloqa uzilsa yoki texnik zarurat bo'lsa) -->
                <Expander Header="Favqulodda ochish (O‘qituvchi / Admin)"
                          Foreground="#64748B" FontSize="11" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <PasswordBox x:Name="UnlockPasswordBox" Width="140" Height="32" Padding="6"
                                     Background="#020617" Foreground="White" BorderBrush="#334155"/>
                        <Button Content="Ochish" Click="EmergencyUnlock_Click" Margin="8,0,0,0"
                                Padding="12,0" Background="#2563EB" Foreground="White" BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
